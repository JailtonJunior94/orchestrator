{
  "hooks": {
    "BeforeTool": [
      {
        "matcher": "edit|write|replace",
        "command": "bash .gemini/hooks/validate-preload.sh"
      }
    ],
    "AfterTool": [
      {
        "matcher": "edit|write|replace",
        "command": "bash .gemini/hooks/validate-governance.sh"
      }
    ],
    "AfterAgent": [
      {
        "command": "bash .gemini/hooks/subagent-stop-wrapper.sh"
      }
    ]
  }
}
