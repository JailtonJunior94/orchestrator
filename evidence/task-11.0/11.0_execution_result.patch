     echo '```yaml'
-    cat "$RESULTS_FILE"
+    sanitize_stream < "$RESULTS_FILE"
     echo
     echo '```'
   else
     echo "(sem resultados anexados)"
   fi
-} >> "$PARTIAL_MD"
+} | atomic_write "$PARTIAL_MD"
 
 echo "post-wave: checkpoint atualizado em $PARTIAL_MD" >&2
 exit 0
