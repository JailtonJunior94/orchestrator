+invalid_payload="$TMP_BASE/git-gate-invalid.json"
+printf 'isto nao e json' >"$invalid_payload"
+assert_gate_exit "JSON inválido bloqueia" 2 "$invalid_payload"
+rm -f "$invalid_payload"
