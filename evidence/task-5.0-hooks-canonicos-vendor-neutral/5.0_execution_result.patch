+		if !ok || event != brokenWant[point] {
+			diverged = true
+		}
+	}
+	if !diverged {
+		t.Fatal("expected the deliberately wrong mapping fixture to diverge from the real projection — the gate would not be able to detect a real divergence")
+	}
+}
