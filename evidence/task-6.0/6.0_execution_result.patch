+    echo "Comando: $command_text" >&2
+    echo "Para prosseguir com pedido explicito do usuario: export GOVERNANCE_INTERPRETER_OPERATION_CONFIRMED=1" >&2
+    exit "$GIT_OPERATION_BLOCK_EXIT"
+  fi
