+		return State{}, fmt.Errorf("ler estado legado: %w", readErr)
+	}
+	backupRef := ""
+	if readErr == nil {
+		backupRef = ".sdd-state." + runID + ".legacy.json"
+	}
+	state := State{
+		SchemaVersion: SchemaVersion,
+		RunID:         runID,
