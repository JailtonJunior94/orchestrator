 	return err == nil
 }
+
+func (s *Store) validBaseSHA(digest string) bool {
+	if len(digest) != 40 && len(digest) != sha256.Size*2 {
+		return false
+	}
+	_, err := hex.DecodeString(digest)
+	return err == nil
+}
