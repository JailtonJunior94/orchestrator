++func normalizeToken(s string) string {
++	s = strings.ToLower(strings.TrimSpace(s))
++	var b strings.Builder
++	prevDash := false
++	for _, r := range s {
++		switch {
++		case r >= 'a' && r <= 'z' || r >= '0' && r <= '9':
++			b.WriteRune(r)
++			prevDash = false
++		default:
++			if !prevDash && b.Len() > 0 {
++				b.WriteByte('-')
++				prevDash = true
++			}
++		}
++	}
++	return strings.TrimRight(b.String(), "-")
++}
