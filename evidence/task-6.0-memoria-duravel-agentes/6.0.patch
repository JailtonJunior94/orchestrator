@@ -24,6 +24,7 @@ type FileSystem interface {
 	EvalSymlinks(path string) (string, error)
 	ReadFile(path string) ([]byte, error)
 	WriteFile(path string, data []byte) error
+	WriteFileAtomic(path string, data []byte) error
