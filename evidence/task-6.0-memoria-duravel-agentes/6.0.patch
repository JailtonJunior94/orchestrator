+// Page_Serialize_Call is a *mock.Call that shadows Run/Return methods with type explicit version for method 'Serialize'
+type Page_Serialize_Call struct {
+	*mock.Call
+}
+
+// Serialize is a helper method to define mock.On call
+//   - facts []durable.Fact
+//   - human durable.HumanBlock
+func (_e *Page_Expecter) Serialize(facts any, human any) *Page_Serialize_Call {
+	return &Page_Serialize_Call{Call: _e.mock.On("Serialize", facts, human)}
+}
+
+func (_c *Page_Serialize_Call) Run(run func(facts []durable.Fact, human durable.HumanBlock)) *Page_Serialize_Call {
+	_c.Call.Run(func(args mock.Arguments) {
+		var arg0 []durable.Fact
+		if args[0] != nil {
+			arg0 = args[0].([]durable.Fact)
+		}
+		var arg1 durable.HumanBlock
+		if args[1] != nil {
+			arg1 = args[1].(durable.HumanBlock)
+		}
+		run(
+			arg0,
+			arg1,
+		)
+	})
+	return _c
+}
+
+func (_c *Page_Serialize_Call) Return(bytes []byte, err error) *Page_Serialize_Call {
+	_c.Call.Return(bytes, err)
+	return _c
+}
+
+func (_c *Page_Serialize_Call) RunAndReturn(run func(facts []durable.Fact, human durable.HumanBlock) ([]byte, error)) *Page_Serialize_Call {
+	_c.Call.Return(run)
+	return _c
+}
