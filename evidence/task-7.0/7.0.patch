+++			Origin:           NewCatalog().formatBugfixOrigin(origin),
+++			RootCause:        entry.RootCause,
+++			FailBefore:       entry.FailBefore,
+++			PassAfter:        entry.PassAfter,
+++			BugfixOutput:     entry.Output,
+++			ReviewVerdict:    reverseVerdict(review.Verdict()),
