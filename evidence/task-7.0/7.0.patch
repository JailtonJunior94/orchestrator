++++			continue
++++		}
++++		for _, description := range taskcriteria.Extract(content) {
++++			key := strings.TrimSpace(description)
++++			if key == "" || seen[key] {
++++				continue
++++			}
++++			seen[key] = true
++++			criterion, err := approval.NewAcceptanceCriterion(description)
++++			if err != nil {
++++				return nil, err
++++			}
++++			criteria = append(criteria, criterion)
++++		}
++++	}
