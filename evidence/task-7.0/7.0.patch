+		}
+	}
+	for id := range budgetsLarge {
+		if !known[id] {
+			return fmt.Errorf("%w: orphan key %q in ToolBudgetsLarge", ErrToolBudgetsLargeCoverage, id)
+		}
+	}
+	return nil
+}
