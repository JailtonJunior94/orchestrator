+func TestOS_WriteFileAtomic_noPartialFileOnInterruption(t *testing.T) {
+	dir := t.TempDir()
+	f := fs.NewOSFileSystem()
+	p := filepath.Join(dir, "atomic.txt")
+
+	if err := f.WriteFileAtomic(p, []byte("original")); err != nil {
+		t.Fatalf("seed WriteFileAtomic: %v", err)
+	}
+
+	interruptedTmp := filepath.Join(dir, ".tmp-interrupted")
+	if err := os.WriteFile(interruptedTmp, []byte("partial-content"), 0o600); err != nil {
+		t.Fatalf("simulate interrupted temp: %v", err)
+	}
+	t.Cleanup(func() { _ = os.Remove(interruptedTmp) })
+
+	data, err := os.ReadFile(p)
+	if err != nil {
+		t.Fatalf("ReadFile final path: %v", err)
+	}
+	if string(data) != "original" {
+		t.Errorf("final path content = %q, want 'original' — interrupted temp must never be visible at final path", data)
+	}
+
+	entries, err := os.ReadDir(dir)
+	if err != nil {
+		t.Fatalf("ReadDir: %v", err)
+	}
+	for _, e := range entries {
