+++	if summary.CycleStopReason != "" {
+++		t.Errorf("CycleStopReason = %q, quero vazio", summary.CycleStopReason)
+++	}
+++
+++	mu.Lock()
+++	defer mu.Unlock()
+++	if calls != 1 {
+++		t.Errorf("reviewOutputFn chamada %d vezes, quero 1 (one-shot, sem rodadas)", calls)
+++	}
+++}
