++++++	}
++++++
++++++	runner := buildRunnerWithReviewFn(t, ctx, script, reviewFn)
++++++
++++++	workDir := gitWorkDirWithAgentsMDForCycle(t)
++++++	tasksDir := t.TempDir()
++++++	writeCycleTaskFile(t, tasksDir, "task-x.md")
++++++
++++++	job := airuntime.Job{
