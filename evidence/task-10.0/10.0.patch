++		t.Errorf("ReviewStatus = %q, quero ok", summary.ReviewStatus)
++	}
++	if summary.CycleStopReason != "approved" {
++		t.Errorf("CycleStopReason = %q, quero approved", summary.CycleStopReason)
++	}
