+++		rounds = append(rounds, CycleRoundSummary{
+++			Number:             round.Number(),
+++			Verdict:            round.Verdict().String(),
+++			FindingsBySeverity: severityCounts(round.CountBySeverity()),
+++		})
+++	}
+++
+++	status := "blocked"
+++	if result.Approved() {
+++		status = "ok"
+++	}
