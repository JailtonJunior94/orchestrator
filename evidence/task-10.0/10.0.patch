+++++	dir := gitInitRepoForAdapter(t)
+++++	if err := os.WriteFile(filepath.Join(dir, "AGENTS.md"), []byte("# Agents\n"), 0o644); err != nil {
+++++		t.Fatalf("write AGENTS.md: %v", err)
+++++	}
