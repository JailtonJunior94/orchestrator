++++	}
++++	if summary.CycleRounds[0].FindingsBySeverity["high"] != 1 {
++++		t.Errorf("CycleRounds[0].FindingsBySeverity[high] = %d, quero 1", summary.CycleRounds[0].FindingsBySeverity["high"])
++++	}
++++}
