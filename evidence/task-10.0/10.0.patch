+++	}
+++	if summary.CancelReason != events.CancelReasonNone {
+++		t.Fatalf("CancelReason = %q, want none — session must survive repeated blocks", summary.CancelReason)
+++	}
+++
+++	failedCount := 0
+++	blockedMessageSeen := false
+++	for _, evt := range persist.events {
