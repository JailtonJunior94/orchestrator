+++		last = round
+++		found = true
+++	}
+++	if !found {
+++		return nil
+++	}
+++	return &FinalReviewResult{
+++		Verdict:  reverseVerdict(last.Verdict()),
+++		Findings: NewCatalog().filterCritical(reverseApprovalFindings(last.Findings())),
+++	}
++ }
