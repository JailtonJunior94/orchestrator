+++++func TestE2EApprovalCycle_ApprovesThirdRoundAfterTwoFixes(t *testing.T) {
+++++	t.Parallel()
+++++
+++++	ctx, cancel := context.WithTimeout(context.Background(), 20*time.Second)
+++++	defer cancel()
+++++
+++++	workDir := gitWorkDirWithAgentsMDForCycle(t)
+++++	tasksDir := t.TempDir()
