+++++		mu.Lock()
+++++		defer mu.Unlock()
+++++		calls++
+++++		if calls == 1 {
+++++			return "Verdict: APPROVED_WITH_REMARKS\n[HIGH] fix.go: precisa de ajuste\n", nil
+++++		}
+++++		return "Verdict: APPROVED\n", nil
+++++	}
+++++
+++++	runner := buildRunnerWithReviewFn(t, ctx, script, reviewFn)
+++++
+++++	workDir := gitWorkDirWithAgentsMDForCycle(t)
