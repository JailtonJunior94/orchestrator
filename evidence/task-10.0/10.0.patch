+++++++func acceptanceCriteriaUnion(prdFolder string, taskIDs []string, fsys fs.FileSystem) ([]approval.AcceptanceCriterion, error) {
+++++++	seen := make(map[string]bool)
+++++++	var criteria []approval.AcceptanceCriterion
