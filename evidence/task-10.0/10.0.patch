++++++		t.Errorf("CycleStopReason = %q, quero approved", summary.CycleStopReason)
++++++	}
++++++	if len(summary.CycleRounds) != 1 {
++++++		t.Fatalf("CycleRounds len = %d, quero 1", len(summary.CycleRounds))
++++++	}
