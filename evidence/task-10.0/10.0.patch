+++				reviewerCalls++
+++				if reviewerCalls == 1 {
+++					return "[Critical] [x.go:1] uninitialized variable\n\nVerdict: REJECTED\n", "", 1, nil
+++				}
+++				return "clean\n\nVerdict: APPROVED\n", "", 0, nil
+++			}}, nil
+++		default:
+++			return nil, fmt.Errorf("tool not configured in test: %s", tool)
+++		}
