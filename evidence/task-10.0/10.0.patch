++++func bugfixAttemptsFromCycle(result approval.CycleResult, recorder *bugfixEvidenceRecorder) []BugfixIteration {
++++	var rounds []approval.Round
++++	for round := range result.Rounds() {
++++		rounds = append(rounds, round)
