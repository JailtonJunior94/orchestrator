+
+    steps:
+      - uses: actions/checkout@v6
+
+      - uses: actions/setup-go@v6
+        with:
+          go-version-file: go.mod
+
+      - name: Setup Node.js (opencode)
+        uses: actions/setup-node@v6
+        with:
+          node-version: "20"
+
+      - name: Install opencode-ai via npm
