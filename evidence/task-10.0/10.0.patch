+++++	if err != nil {
+++++		return autoReviewOutcome{}, fmt.Errorf("runApprovalCycle: %w", err)
+++++	}
+++++	policy, err := approval.NewApprovalPolicy()
+++++	if err != nil {
+++++		return autoReviewOutcome{}, fmt.Errorf("runApprovalCycle: %w", err)
+++++	}
+++++
+++++	baseJob := j
+++++	baseJob.AutoReview = false
+++++
+++++	reviewer := NewReviewerAdapter(r, baseJob)
