++++		EvidenceDir:  t.TempDir(),
++++		Quiet:        true,
++++		AutoReview:   true,
++++		TasksDir:     tasksDir,
++++		TaskFileName: "task-x.md",
++++	}
++++
++++	summary, err := runner.Run(ctx, job)
