++++		t.Errorf("tool_calls.md = %q, want to contain 'bash'", tcData)
++++	}
++++
++++	eventsData, err := fakeFS.ReadFile(evidenceDir + "/events.jsonl")
++++	if err != nil {
++++		t.Fatalf("events.jsonl not found: %v", err)
++++	}
