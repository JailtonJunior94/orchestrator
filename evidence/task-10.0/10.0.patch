++++++		AutoReview:   true,
++++++		TasksDir:     tasksDir,
++++++		TaskFileName: "task-x.md",
++++++	}
++++++
++++++	summary, err := runner.Run(ctx, job)
++++++	if err != nil {
++++++		t.Fatalf("Run falhou: %v", err)
++++++	}
++++++
++++++	if summary.ReviewStatus != "ok" {
++++++		t.Errorf("ReviewStatus = %q, quero ok", summary.ReviewStatus)
++++++	}
