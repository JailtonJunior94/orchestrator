+func TestAcpClient_HandshakeSuccessAllowsSessionToProceed(t *testing.T) {
+	t.Parallel()
+
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+
+	script := acpfake.NewScript().
