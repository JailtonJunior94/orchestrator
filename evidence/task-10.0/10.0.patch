+++		}
+++		finding, err := approval.NewFinding(severity, file, cycleFindingRule, strings.TrimSpace(line))
+++		if err != nil {
+++			continue
+++		}
+++		findings = append(findings, finding)
+++	}
+++	return findings
+++}
