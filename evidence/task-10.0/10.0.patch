++++func newE2ECycleJob(workDir, tasksDir, evidenceDir string) airuntime.Job {
++++	return airuntime.Job{
++++		Prompt:       "implement task x",
++++		WorkDir:      workDir,
++++		EvidenceDir:  evidenceDir,
++++		Quiet:        true,
++++		AutoReview:   true,
++++		TasksDir:     tasksDir,
++++		TaskFileName: "task-x.md",
++++	}
++++}
