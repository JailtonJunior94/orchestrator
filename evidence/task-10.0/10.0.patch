+++		BugfixInvoker: bugfixInvoker,
+++		DiffCapturer:  &runloopDiffCapturer{},
+++	}
+++
+++	report, err := svc.RunLoop(context.Background(), Options{PRDFolder: prd, MaxBugfixIterations: 3}, deps)
+++	if err != nil {
+++		t.Fatalf("RunLoop: unexpected error: %v", err)
+++	}
