+++		t.Fatalf("Run falhou: %v", err)
+++	}
+++
+++	if summary.CycleRounds != nil {
+++		t.Errorf("CycleRounds = %v, quero nil (fallback one-shot sem Cycle)", summary.CycleRounds)
