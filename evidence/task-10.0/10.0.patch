++++++		t.Errorf("CycleRounds[0].Number = %d, quero 1", summary.CycleRounds[0].Number)
++++++	}
++++++	if summary.CycleRounds[0].Verdict != "APPROVED" {
++++++		t.Errorf("CycleRounds[0].Verdict = %q, quero APPROVED", summary.CycleRounds[0].Verdict)
++++++	}
++++++}
