++++func (f *paritySequencedClientFactory) New(workDir string) client.Client {
++++	f.t.Helper()
++++	if f.idx >= len(f.calls) {
++++		f.t.Fatalf("paritySequencedClientFactory: call %d exceeds planned script (%d entries)", f.idx, len(f.calls))
++++	}
++++	call := f.calls[f.idx]
++++	f.idx++
