+++		}
+++	}
+++
+++	if execOutcome != runLoopOutcome || runLoopOutcome != acpOutcome {
+++		t.Errorf("parity mismatch across the three paths: Service.Execute=%+v RunLoop=%+v ACPRunner=%+v",
+++			execOutcome, runLoopOutcome, acpOutcome)
+++	}
