+++	for round := range result.Rounds() {
+++		rounds = append(rounds, round)
+++	}
+++	entries := recorder.Entries()
+++	total := len(entries)
+++	if len(rounds)-1 < total {
+++		total = len(rounds) - 1
+++	}
+++	if total < 0 {
+++		total = 0
+++	}
