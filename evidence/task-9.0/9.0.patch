+const originalWarn = console.warn
+console.warn = (...args) => { warnings++; originalWarn(...args) }
+for (let i = 0; i < 2; i++) {
+  await hooks["tool.execute.before"]({ tool: "edit", sessionID: "s", callID: "c" + i }, { args: { filePath: "file" + i + ".go" } })
