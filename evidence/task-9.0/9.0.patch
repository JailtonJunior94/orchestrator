++++func severityCounts(counts map[approval.Severity]int) map[string]int {
++++	if len(counts) == 0 {
++++		return nil
++++	}
++++	result := make(map[string]int, len(counts))
++++	for severity, n := range counts {
++++		result[severity.String()] = n
++++	}
++++	return result
++++}
