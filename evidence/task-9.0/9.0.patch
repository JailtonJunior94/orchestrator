+func TestNoLauncherUsesLatestVersion(t *testing.T) {
+	t.Parallel()
+
+	for _, agent := range specs.NewCatalog().Registry() {
+		spec, err := specs.NewCatalog().SpecOf(agent)
+		if err != nil {
+			t.Fatalf("SpecOf(%q): %v", agent.ID(), err)
