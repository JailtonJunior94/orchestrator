+++++			durability: durable.DurabilityDurable,
+++++			wantLayer:  durable.TargetLayerProject,
+++++		},
+++++		{
+++++			name:       "should reject zero-value durability",
+++++			durability: durable.DurabilityInvalid,
+++++			wantErr:    durable.ErrDurabilityMissing,
+++++		},
+++++	}
