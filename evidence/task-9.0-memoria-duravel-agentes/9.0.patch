+++	first, err := policy.Sanitize(content, durable.SanitizationConfig{})
+++	s.Require().NoError(err)
+++	second, err := policy.Sanitize(content, durable.SanitizationConfig{})
+++	s.Require().NoError(err)
+++
+++	s.Equal(first, second)
+++}
