+++			content:      "connect to postgres://db.internal:5432/app",
+++			wantRedacted: false,
+++		},
+++	}
+++
+++	for _, sc := range scenarios {
+++		s.Run(sc.name, func() {
+++			policy := durable.SanitizationPolicy{}
+++
+++			result, err := policy.Sanitize(sc.content, durable.SanitizationConfig{})
+++
+++			s.Require().NoError(err)
+++			if sc.wantRedacted {
