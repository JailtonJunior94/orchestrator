++++			Identity:   durable.Identity{Key: "payment.retry"},
++++			Durability: durable.DurabilityInvalid,
++++		},
++++	}, durable.HumanBlock{})
++++
++++	s.True(errors.Is(err, durable.ErrDurabilityMissing))
++++}
