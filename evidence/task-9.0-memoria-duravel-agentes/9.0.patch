+++	}
+++
+++	expectedContent := human.Content
+++	if needsSeparator {
+++		expectedContent += "\n"
+++	}
+++	if humanReparsed.Content != expectedContent {
+++		return nil, ErrRoundTripNotPreserved
+++	}
+++
+++	return output, nil
