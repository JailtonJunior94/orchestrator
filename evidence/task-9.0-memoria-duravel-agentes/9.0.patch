+++
+++func (h *promptCaptureHook) Name() string { return "golden_prompt_capture" }
+++
+++func (h *promptCaptureHook) Run(_ context.Context, evt hooks.Event) error {
+++	pb, ok := evt.(hooks.PromptBuildEvent)
+++	if !ok || pb.Prompt == nil {
+++		return nil
+++	}
+++	h.captured = *pb.Prompt
+++	return nil
