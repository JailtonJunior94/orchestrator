++++		byLayer[quota.Layer] = quota.Tokens
++++	}
++++
++++	s.Equal(500, byLayer[durable.TargetLayerProject])
++++	s.Equal(300, byLayer[durable.TargetLayerPRD])
++++	s.Equal(200, byLayer[durable.TargetLayerTask])
