++++		return returnFunc(facts, human)
++++	}
++++	if returnFunc, ok := ret.Get(0).(func([]durable.Fact, durable.HumanBlock) []byte); ok {
++++		r0 = returnFunc(facts, human)
++++	} else {
++++		if ret.Get(0) != nil {
++++			r0 = ret.Get(0).([]byte)
++++		}
++++	}
++++	if returnFunc, ok := ret.Get(1).(func([]durable.Fact, durable.HumanBlock) error); ok {
++++		r1 = returnFunc(facts, human)
++++	} else {
++++		r1 = ret.Error(1)
++++	}
++++	return r0, r1
++++}
