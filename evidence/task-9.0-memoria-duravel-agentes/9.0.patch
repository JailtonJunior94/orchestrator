++++func (c *Catalog) ValidateFact(f Fact) error {
++++	if f.Identity.Key == "" {
++++		return ErrSemanticKeyMissing
++++	}
++++	if f.Durability == DurabilityInvalid {
++++		return ErrDurabilityMissing
++++	}
++++	return nil
++++}
