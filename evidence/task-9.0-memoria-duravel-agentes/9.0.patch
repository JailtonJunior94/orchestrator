++++	needsSeparator := len(facts) > 0 && human.Content != "" && !strings.HasSuffix(human.Content, "\n")
++++	if needsSeparator {
++++		b.WriteString("\n")
++++	}
++++
++++	for _, f := range facts {
++++		metadata := factMetadataYAML{
++++			Hash:       f.Identity.Hash,
++++			Durability: f.Durability,
++++			State:      f.State,
++++			Origin:     f.Origin,
++++			Content:    f.Content,
++++			Links:      f.Links,
++++		}
++++		metadataYAML, err := yaml.Marshal(metadata)
++++		if err != nil {
++++			return nil, fmt.Errorf("durable: failed to serialize fact: %w", err)
++++		}
++++		b.WriteString("### Fact: ")
++++		b.WriteString(string(f.Identity.Key))
++++		b.WriteString("\n")
++++		b.WriteString(factMetadataFence)
++++		b.WriteString("\n")
++++		b.Write(metadataYAML)
++++		b.WriteString("```\n")
++++	}
++++
++++	output := []byte(b.String())
++++
++++	_, humanReparsed, err := p.Parse(output)
++++	if err != nil {
++++		return nil, fmt.Errorf("durable: failed to validate round-trip: %w", err)
++++	}
++++
++++	expectedContent := human.Content
++++	if needsSeparator {
++++		expectedContent += "\n"
++++	}
++++	if humanReparsed.Content != expectedContent {
++++		return nil, ErrRoundTripNotPreserved
++++	}
++++
++++	return output, nil
++++}
