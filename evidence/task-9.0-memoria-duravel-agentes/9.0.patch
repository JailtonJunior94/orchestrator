+++func TestPromptParityGolden_AnchoredAtHookDispatch(t *testing.T) {
+++	t.Parallel()
+++
+++	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+++	defer cancel()
+++
+++	tasksDir := t.TempDir()
