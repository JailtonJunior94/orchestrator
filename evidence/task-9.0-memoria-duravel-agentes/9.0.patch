+++++func (s *PageSuite) TestRoundTripOnRealRepositoryCorpus() {
+++++	repoRoot := "../../../.."
+++++	corpus := []string{
+++++		repoRoot + "/AGENTS.md",
+++++		repoRoot + "/README.md",
+++++		repoRoot + "/docs/config-hierarchy.md",
+++++		repoRoot + "/docs/guia-instalacao-universal.md",
