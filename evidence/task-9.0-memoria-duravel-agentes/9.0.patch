+++func (_e *FileSystem_Expecter) WriteFileAtomic(path any, data any) *FileSystem_WriteFileAtomic_Call {
+++	return &FileSystem_WriteFileAtomic_Call{Call: _e.mock.On("WriteFileAtomic", path, data)}
