++++type PageHeader struct {
++++	Identity      string      `yaml:"identity"`
++++	Layer         TargetLayer `yaml:"layer"`
++++	OriginSession string      `yaml:"origin_session"`
++++	Date          string      `yaml:"date"`
++++	FormatVersion int         `yaml:"format_version"`
