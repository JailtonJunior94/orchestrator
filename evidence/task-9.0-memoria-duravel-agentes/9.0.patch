++
++func (s *SanitizationPolicySuite) TestSanitizeIsExtensibleByConfig() {
++	custom, err := durable.NewSanitizationPattern("internal_ticket_id", `\bTICKET-\d{5}\b`)
++	s.Require().NoError(err)
