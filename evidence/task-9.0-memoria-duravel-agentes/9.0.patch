+++++	if err := tmp.Sync(); err != nil {
+++++		_ = tmp.Close()
+++++		return fmt.Errorf("sync temp file %s: %w", tmpPath, err)
+++++	}
+++++	if err := tmp.Close(); err != nil {
+++++		return fmt.Errorf("close temp file %s: %w", tmpPath, err)
+++++	}
