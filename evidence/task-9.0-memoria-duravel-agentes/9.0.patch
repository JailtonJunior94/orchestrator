++		sb.WriteString(workflowContent)
++		want := sb.String()
++
++		if capture.captured != want {
++			t.Errorf("captured prompt = %q, want %q", capture.captured, want)
++		}
++	})
++
++	t.Run("case 3: workflow and task in correct order", func(t *testing.T) {
