+++	summary, runErr := runner.Run(ctx, job)
+++
+++	if runErr != nil {
+++		t.Fatalf("Run: session must not abort on memory dispatch failure; got err=%v", runErr)
+++	}
+++
+++	if len(summary.HookDispatchErrors) == 0 {
