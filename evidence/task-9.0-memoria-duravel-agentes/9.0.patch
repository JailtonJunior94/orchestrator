++++++			s.Require().NoError(err)
++++++
++++++			gotFacts, gotHuman, err := page.Parse(output)
++++++			s.Require().NoError(err)
++++++
++++++			expectedContent := sc.human.Content
++++++			if len(sc.facts) > 0 && expectedContent != "" && expectedContent[len(expectedContent)-1] != '\n' {
++++++				expectedContent += "\n"
