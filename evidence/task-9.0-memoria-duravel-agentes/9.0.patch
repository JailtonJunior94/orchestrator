@@ -0,0 +1,55 @@
+package durable_test
+
+import (
+	"context"
+	"fmt"
+	"testing"
+	"time"
+
+	"github.com/JailtonJunior94/ai-spec-harness/internal/fs"
+	"github.com/JailtonJunior94/ai-spec-harness/internal/runtime/memory/durable"
+)
+
+// TestBuildContextP95PreliminaryBenchmark_1000Pages e o benchmark preliminar exigido
+// pelo criterio de sucesso da tarefa 7.0 (RF-20): confirma que BuildContext permanece
+// abaixo de 200ms com 1.000 paginas de fato acumuladas na camada de projeto. O
+// benchmark completo com Makefile e multiplas execucoes cabe a tarefa 10.0; este teste
+// e a confirmacao preliminar exigida ainda em 7.0.
+func TestBuildContextP95PreliminaryBenchmark_1000Pages(t *testing.T) {
+	fsys := fs.NewFakeFileSystem()
+	layer := durable.NewLayerWithLocker(fsys, newInMemoryLayerLocker())
+	facade := durable.NewFacadeWithLayer(fsys, layer, durable.FacadeConfig{
+		ProjectDir: "/project",
+	})
+
+	const pageCount = 1000
+	ctx := context.Background()
+	for i := 0; i < pageCount; i++ {
+		_, err := facade.RecordSession(ctx, durable.SessionFacts{
+			TaskFileName:    fmt.Sprintf("task-%d.0.md", i),
+			ExitStatus:      "none",
+			EventsCount:     i,
+			DeclaredSection: fmt.Sprintf("durable fact number %d for benchmark coverage", i),
+		})
+		if err != nil {
+			t.Fatalf("RecordSession(%d): %v", i, err)
+		}
+	}
+
+	const samples = 5
+	var worst time.Duration
+	for i := 0; i < samples; i++ {
+		start := time.Now()
+		if _, err := facade.BuildContext(ctx, durable.MemoryScope{}); err != nil {
+			t.Fatalf("BuildContext: %v", err)
+		}
+		elapsed := time.Since(start)
+		if elapsed > worst {
+			worst = elapsed
+		}
+	}
+
+	if worst > 200*time.Millisecond {
+		t.Errorf("BuildContext p95 preliminar com %d paginas = %v, want < 200ms (RF-20)", pageCount, worst)
+	}
+}
diff --git a/internal/runtime/memory/durable/facade_test.go b/internal/runtime/memory/durable/facade_test.go
