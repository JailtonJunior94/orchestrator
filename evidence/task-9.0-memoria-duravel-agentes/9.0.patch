++++
++++	facts := []durable.Fact{
++++		{
++++			Identity:   durable.Identity{Key: "project.a"},
++++			Durability: durable.DurabilityDurable,
++++			Content:    strings.Repeat("x", 700),
++++		},
++++	}
++++
++++	allocation := policy.Allocate(budget, facts)
++++
++++	s.Empty(allocation.Selected)
++++	s.Len(allocation.Omitted, 1)
++++}
