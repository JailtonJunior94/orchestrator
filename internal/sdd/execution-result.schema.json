{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "execution-result.schema.json",
  "title": "Resultado de execução SDD v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "task_id", "attempt", "status", "base_sha", "patch_sha256", "final_state_sha256", "coverage_regression", "tests", "criteria", "evidence", "review_verdict"],
  "properties": {
    "schema_version": {"const": 2},
    "run_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"},
    "attempt": {"type": "integer", "minimum": 1},
    "status": {"enum": ["blocked", "needs_input", "failed", "done"]},
    "base_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40,64}$"},
    "patch_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "patch_ref": {"type": "string", "minLength": 1},
    "final_state_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "coverage_regression": {"type": "boolean"},
    "tests": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["command", "exit_code", "output_sha256"], "properties": {"command": {"type": "string", "minLength": 1}, "exit_code": {"type": "integer"}, "output_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}}}},
    "criteria": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "evidence_ref"], "properties": {"id": {"type": "string", "minLength": 1}, "evidence_ref": {"type": "string", "minLength": 1}}}},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "review_verdict": {"enum": ["approved", "changes_requested", "needs_input"]}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "done"}}}, "then": {"required": ["patch_ref"], "properties": {"coverage_regression": {"const": false}, "review_verdict": {"const": "approved"}, "tests": {"items": {"properties": {"exit_code": {"const": 0}}}}}}}
  ]
}
